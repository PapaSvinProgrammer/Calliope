# Database credentials — copy this file to .env and fill in real values
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/radio
SPRING_DATASOURCE_USERNAME=radio
SPRING_DATASOURCE_PASSWORD=change_me_to_a_strong_password

# Hibernate schema mode: update (auto-create tables) | validate (check only) | none
SPRING_JPA_HIBERNATE_DDL_AUTO=update
